# Copy to .env and change values for your local MySQL instance.
APEX_DB_URL=jdbc:mysql://localhost:3306/apex_turf?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
APEX_DB_USERNAME=root
APEX_DB_PASSWORD=change-me
APEX_DB_POOL_SIZE=10

# Optional email notifications. Leave blank to keep email disabled.
APEX_MAIL_SENDER=
APEX_MAIL_PASSWORD=
APEX_ADMIN_EMAIL=
